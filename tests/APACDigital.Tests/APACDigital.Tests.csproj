<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Testes automáticos do APAC Digital (geração do PDF, cadastro de profissionais e tela).
    Executar a partir da raiz do repositório: dotnet run, apontando para este projeto (veja o README).
    Retorna 0 quando todos passam; o número de falhas caso contrário.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <IsPackable>false</IsPackable>
    <RootNamespace>APACDigital.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\apac_biblioteca.csproj" />
  </ItemGroup>

</Project>
